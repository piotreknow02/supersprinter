<?xml version='1.0' encoding='windows-1252'?>
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>
<?if $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformInstallerVersion = "500" ?>
<?else ?>
    <?define PlatformInstallerVersion = "450" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
    <Product
        Id='*'
        Name='Supersprinter'
        UpgradeCode='{7E3F1D0A-5C2B-4F8E-9A6D-1B3C5D7E9F01}'
        Manufacturer='piotreknow02'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package
            Id='*'
            Keywords='Installer'
            Description='RSVP speed reader'
            Manufacturer='piotreknow02'
            InstallerVersion='$(var.PlatformInstallerVersion)'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'/>

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='Supersprinter Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='Supersprinter'>
                    <Component Id='License' Guid='*'>
                        <File
                            Id='LicenseFile'
                            Name='LICENSE'
                            DiskId='1'
                            Source='LICENSE'
                            KeyPath='yes'/>
                    </Component>

                    <Directory Id='Bin' Name='bin'>
                        <Component Id='MainBinary' Guid='*'>
                            <File
                                Id='MainExeFile'
                                Name='supersprinter.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\supersprinter.exe'
                                KeyPath='yes'/>
                        </Component>
                    </Directory>
                </Directory>
            </Directory>

            <Directory Id='ProgramMenuFolder'>
                <Directory Id='SupersprinterProgramMenuDir' Name='Supersprinter'>
                    <Component Id='StartMenuShortcut' Guid='*'>
                        <Shortcut
                            Id='SupersprinterStartMenuShortcut'
                            Directory='SupersprinterProgramMenuDir'
                            Name='Supersprinter'
                            Description='RSVP speed reader'
                            Target='[Bin]supersprinter.exe'
                            WorkingDirectory='APPLICATIONFOLDER'
                            Icon='ProductICO'
                            IconIndex='0'
                            Advertise='no'/>
                        <RemoveFolder Id='RemoveSupersprinterProgramMenuDir' Directory='SupersprinterProgramMenuDir' On='uninstall'/>
                        <RegistryValue
                            Root='HKCU'
                            Key='Software\piotreknow02\Supersprinter'
                            Name='StartMenuShortcut'
                            Type='integer'
                            Value='1'
                            KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs the application with the bundled FFmpeg media libraries.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>
            <ComponentRef Id='License'/>
            <ComponentRef Id='MainBinary'/>
            <ComponentRef Id='StartMenuShortcut'/>
            <!-- The FFmpeg DLLs are emitted by scripts/windows/gen-ffmpeg-wxs.ps1
                 and passed to cargo-wix via its include option. -->
            <ComponentGroupRef Id='FfmpegGroup'/>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <Icon Id='ProductICO' SourceFile='assets\supersprinter.ico'/>
        <Property Id='ARPPRODUCTICON' Value='ProductICO'/>
        <Property Id='ARPHELPLINK' Value='https://github.com/piotreknow02/supersprinter'/>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>
            <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='CustomizeDlg' Order='99'>1</Publish>
            <Publish Dialog='CustomizeDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg' Order='99'>1</Publish>
        </UI>
    </Product>
</Wix>
